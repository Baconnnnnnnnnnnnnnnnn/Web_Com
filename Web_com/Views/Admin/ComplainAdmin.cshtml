@{
    ViewBag.Title = "Account Admin - Web_Com";

    var adminRoleId = Session["AdminRoleId"] as int?;
    var hasAccess = adminRoleId == 5;

    Layout = hasAccess ? "~/Views/Shared/_AdminLayout.cshtml" : null;

    ViewBag.AccessDenied = !hasAccess;
}

@if (hasAccess)
{

    <h2>ComplainAdmin</h2>
    <link href="~/Content/anime-login.css" rel="stylesheet" />

    <div class="anime-background"></div>
    <div class="anime-overlay"></div>

    <script>
$(document).ready(function() {
    var hasAccess = @(ViewBag.AccessDenied != null && !(bool)ViewBag.AccessDenied ? "true" : "false");

    if (!hasAccess) {
        return;
    }
});
    </script>
}
else {}