@{
    ViewBag.Title = "Super Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Kiểm tra role
    var adminRoleId = Session["AdminRoleId"] as int?;
    if (adminRoleId != 1)
    {
        ViewBag.AccessDenied = true;
    }
}

<h2>SuperAdmin</h2>
<link href="~/Content/anime-login.css" rel="stylesheet" />

<div class="anime-background"></div>
<div class="anime-overlay"></div>

<div class="admin-logout-container">
    <a href="/Home/Web_Com" class="anime-btn anime-btn-logout">
        <i class="fa fa-sign-out-alt"></i> Logout
    </a>
</div>
